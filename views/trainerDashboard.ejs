<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= trainer.name %>'s Dashboard</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">

</head>
<body>

  <header>
    <h1>Welcome, <%= trainer.name.trim() %>!</h1>
    <p>Your Pokémon Collection</p>
  </header>

  <main>
    <% if (pokemons.length > 0) { %>
      <h2 style="text-align: center;">Your Pokémon Team</h2>
      <div class="pokemon-list">
        <% pokemons.forEach(function(pokemon) { %>
          <div class="pokemon-card">
            <img 
              src="https://img.pokemondb.net/sprites/sword-shield/icon/<%= pokemon.name.toLowerCase() %>.png" 
              alt="<%= pokemon.name %>" 
              class="pokemon-icon"
              onerror="this.src='/images/default-icon.png'">
            <h3><%= pokemon.name %></h3>
            <p>Level: <%= pokemon.level %></p>
            <p>Type: <%= pokemon.Type.name %></p>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p style="text-align: center;">No Pokémon found. <a href="/pokemons/add">Add a Pokémon</a></p>
    <% } %>
  
    <div style="text-align: center; margin-top: 2rem;">
      <a href="/pokemons/add"><button>Add a Pokémon</button></a>
      <a href="/"><button>Go Home</button></a>
    </div>
  </main>

  <footer>
    <p>&copy; 2025 Pokémon Trainer App</p>
  </footer>

</body>
</html>
